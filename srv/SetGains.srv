# Set the force-mode position-loop gains for one hand (SDK service cmd 14).
#
# Applies to every joint of that hand. Per-joint gains exist in the SDK
# (Api::serviceGains takes a JointMask) but are deliberately not exposed here:
# from ROS the hand is one unit, and a control type that had to track which
# joints were running which gains could not reason about the hand at all.
#
# Both are s16en11 on the wire, so the usable range is [-16, 16); values outside
# it saturate at the INT16 rail rather than wrapping.
float32 kp      # N*m/rad
float32 kd      # N*m*s/rad
---
bool success
string message
# What the device reports back, per joint, in the node's joint order. Empty
# when the call failed.
float32[] kp_readback
float32[] kd_readback
